      "source": [
        "def reverse_array(a):\n",
        "  j=len(a)-1\n",
        "  i=0\n",
        "  while i<j:\n",
        "    a[i],a[j]=a[j],a[i]\n",
        "    i+=1\n",
        "    j-=1\n",
        "  return a\n",
        "# Time Complexity: O(n)\n",
        "# Auxiliary Space Complexity: O(1)\n",
        "a=[1,2,3,4,5]\n",
        "print(reverse_array(a))\n",
        "b=[2]\n",
        "print(reverse_array(b))\n",
        "c=[]\n",
        "print(reverse_array(c))\n"
      ]
    }
  ]
}